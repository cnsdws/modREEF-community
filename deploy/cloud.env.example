PORT=3001
MODREEF_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
MODREEF_OIDC_ISSUER=https://YOUR-OIDC-ISSUER
MODREEF_OIDC_AUDIENCE=https://api.modreef.net
# Optional when the provider does not publish keys at the default issuer path.
MODREEF_OIDC_JWKS_URL=https://YOUR-OIDC-ISSUER/.well-known/jwks.json
MODREEF_ALLOWED_ORIGINS=https://www.modreef.net,https://modreef.net
MODREEF_PUBLIC_API_URL=https://api.modreef.net
MODREEF_PUBLIC_APP_URL=https://www.modreef.net
# Optional transactional invitation email. Invitations remain shareable in the
# UI when these are absent.
RESEND_API_KEY=REPLACE_WITH_TRANSACTIONAL_EMAIL_API_KEY
MODREEF_INVITATION_FROM_EMAIL=modREEF <invites@YOUR_VERIFIED_DOMAIN>
# High-entropy secret shared only with the release-candidate GitHub workflow.
MODREEF_RELEASE_PUBLISH_TOKEN=GENERATE_A_RANDOM_RELEASE_PUBLICATION_TOKEN
# The matching private Ed25519 PEM is stored only as the protected GitHub
# secret MODREEF_EDGE_RELEASE_SIGNING_KEY. Never place it in this file.
