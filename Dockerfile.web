FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.11.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY patches patches
COPY apps/mobile/package.json apps/mobile/package.json
COPY packages/api-contract/package.json packages/api-contract/package.json
COPY packages/cloud-client/package.json packages/cloud-client/package.json
COPY packages/device-integration/package.json packages/device-integration/package.json
COPY packages/digital-twin/package.json packages/digital-twin/package.json
COPY packages/driver-yinmik-water/package.json packages/driver-yinmik-water/package.json
COPY packages/foundation/package.json packages/foundation/package.json
COPY packages/hal/package.json packages/hal/package.json
COPY packages/onboarding/package.json packages/onboarding/package.json
RUN pnpm install --frozen-lockfile --prod=false

COPY apps/mobile apps/mobile
COPY packages/api-contract packages/api-contract
COPY packages/cloud-client packages/cloud-client
COPY packages/device-integration packages/device-integration
COPY packages/digital-twin packages/digital-twin
COPY packages/driver-yinmik-water packages/driver-yinmik-water
COPY packages/foundation packages/foundation
COPY packages/hal packages/hal
COPY packages/onboarding packages/onboarding

ENV EXPO_PUBLIC_MODREEF_CONNECTION_MODE=cloud
ENV EXPO_PUBLIC_MODREEF_CLOUD_URL=https://api.modreef.net
RUN pnpm --filter @modreef/mobile export:web

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/mobile/dist ./dist
COPY --from=build --chown=node:node /app/apps/mobile/scripts/serve-web.mjs ./serve-web.mjs
USER node
EXPOSE 3000
CMD ["node", "serve-web.mjs"]
