{
  "name": "@modreef/cloud-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:production": "pnpm migrate && pnpm start",
    "migrate": "tsx src/migrate.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modreef/api-contract": "workspace:*",
    "jose": "^6.2.12",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
